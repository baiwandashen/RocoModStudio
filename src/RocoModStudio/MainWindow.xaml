<Window x:Class="RocoModStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roco Mod Studio" Icon="Assets/app-icon.png" Height="900" Width="1500" MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="22,24,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="R" Foreground="White" FontWeight="Bold" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ROCO MOD" Foreground="White" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="STUDIO" Foreground="#79BDB8" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Roco Kingdom World 资源工作台" Foreground="#78989B" FontSize="11" Margin="0,15,0,0"/>
                </StackPanel>

                <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}" SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Tag="Home"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="18" Margin="0,0,13,0"/><TextBlock Text="开始与项目" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Pak"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="17" Margin="0,0,13,0"/><TextBlock Text="PAK 提取 / 打包" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="FModel"><StackPanel Orientation="Horizontal"><TextBlock Text="▥" FontSize="17" Margin="0,0,13,0"/><TextBlock Text="游戏包解包 / FModel" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>                    <ListBoxItem Tag="Asset"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="18" Margin="0,0,13,0"/><TextBlock Text="蓝图与资源编辑" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Texture"><StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="18" Margin="0,0,13,0"/><TextBlock Text="贴图工作台" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Nrc"><StackPanel Orientation="Horizontal"><TextBlock Text="⇄" FontSize="18" Margin="0,0,13,0"/><TextBlock Text="NRC 魔改转换" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Pet"><StackPanel Orientation="Horizontal"><TextBlock Text="✦" FontSize="17" Margin="0,0,13,0"/><TextBlock Text="宠物外观替换" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Blender"><StackPanel Orientation="Horizontal"><TextBlock Text="◒" FontSize="18" Margin="0,0,13,0"/><TextBlock Text="Blender / Cook 模型" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>                    <ListBoxItem Tag="Pack"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="17" Margin="0,0,13,0"/><TextBlock Text="Mod 发布打包" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="17" Margin="0,0,13,0"/><TextBlock Text="工具与设置" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></StackPanel></ListBoxItem>
                </ListBox>

                <Border Grid.Row="2" Margin="12" Padding="12" CornerRadius="9" Background="#12363B">
                    <StackPanel>
                        <TextBlock Text="当前项目" Foreground="#7FA4A7" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SidebarProjectText" Text="尚未创建" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="v0.4.1 · Stable Fix" Foreground="#6F9497" FontSize="10" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="168"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FAFCFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="开始与项目" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitleText" Text="创建 Mod 项目，并按工作流完成提取、编辑、转换与发布" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource PillStyle}" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BusyDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BusyText" Text="就绪" Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ProgressBar x:Name="BusyProgress" Width="130" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/><Button x:Name="CancelOperationButton" Content="取消" Visibility="Collapsed" Margin="8,0,0,0" Padding="10,4" Style="{StaticResource SecondaryButtonStyle}" Click="CancelOperation_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="22,18,22,10">
                    <Grid x:Name="HomePage">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border CornerRadius="14" Padding="26" Margin="0,0,0,16">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0C3539" Offset="0"/><GradientStop Color="#0D9488" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="从 Cooked 资源到可安装 PAK" Foreground="White" FontSize="27" FontWeight="Bold"/>
                                    <TextBlock Text="一个工作台完成资源提取、结构编辑、材质贴图、NRC 兼容转换和宠物外观替换。" Foreground="#D4F1EE" FontSize="14" Margin="0,10,30,18" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="创建 Mod 项目" Style="{StaticResource PrimaryButtonStyle}" Background="White" Foreground="#0B6B64" BorderBrush="White" Click="CreateProject_Click"/>
                                        <Button Content="提取现有 PAK" Style="{StaticResource SecondaryButtonStyle}" Background="#28FFFFFF" Foreground="White" BorderBrush="#55FFFFFF" Click="QuickPak_Click"/>
                                        <Button Content="宠物 BP 替换" Style="{StaticResource SecondaryButtonStyle}" Background="#28FFFFFF" Foreground="White" BorderBrush="#55FFFFFF" Click="QuickPet_Click"/><Button Content="一键排查" Style="{StaticResource SecondaryButtonStyle}" Background="#28FFFFFF" Foreground="White" BorderBrush="#55FFFFFF" Click="RunDiagnostics_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#22FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="11" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="运行前检查" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="HomeHealthSummary" Text="正在检测工具..." Foreground="#D9F5F2" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="HomeHealthBar" Maximum="6" Value="0" Margin="0,14,0,0" Foreground="White" Background="#42FFFFFF"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="标准工作流" Style="{StaticResource SectionTitleStyle}"/>
                                <UniformGrid Columns="5">
                                    <StackPanel Margin="0,0,10,0"><Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="提取源文件" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="解包 PAK，整理 Content 与贴图目录" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="2" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="编辑资源" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="蓝图/资源 JSON 往返与结构校验" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="3" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="替换贴图" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="向 UE4.26 纹理资产注入 DDS/图像" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="4" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="兼容转换" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="纹理 NRC 结构转换并输出报告" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel><Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="5" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="打包发布" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="验证目录并生成可挂载 PAK" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="新建项目" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="项目名" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="ProjectNameBox" Text="MyRocoMod"/>
                                    <TextBlock Text="保存位置" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ProjectRootBox" Margin="0,0,8,0"/><Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButtonStyle}" Tag="ProjectRootBox" Click="BrowseFolder_Click"/></Grid>
                                    <TextBlock Text="游戏 Paks 目录" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OneClickPaksBox" Margin="0,0,8,0"/><Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButtonStyle}" Tag="OneClickPaksBox" Click="BrowseFolder_Click"/></Grid>
                                    <TextBlock Text="AES Key" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/>
                                    <TextBox x:Name="OneClickAesBox"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="创建项目结构" Style="{StaticResource SecondaryButtonStyle}" Click="CreateProject_Click"/>
                                        <Button Content="一键解包并进入编辑" Style="{StaticResource PrimaryButtonStyle}" Click="OneClickPipeline_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="自动创建 working、pack-root、dist、reports 四个目录，并保存项目清单。" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="工具链状态" Style="{StaticResource SectionTitleStyle}"/>
                                    <StackPanel x:Name="HomeToolStatusStack"/>
                                    <Button Content="打开完整设置" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenSettings_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="PakPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="读取现有 PAK" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="选择 .pak 后可查看摘要、列出条目或安全解包。解包默认会剥离 ../../../ 挂载前缀。" Style="{StaticResource CaptionStyle}" Margin="0,0,0,12"/>
                                <TextBlock Text="PAK 文件" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PakFileBox" Margin="0,0,8,0"/><Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButtonStyle}" Tag="PakFileBox|UE PAK|*.pak" Click="BrowseFile_Click"/></Grid>
                                <TextBlock Text="解包输出目录" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PakUnpackOutputBox" Margin="0,0,8,0"/><Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButtonStyle}" Tag="PakUnpackOutputBox" Click="BrowseFolder_Click"/></Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="查看信息" Style="{StaticResource PrimaryButtonStyle}" Click="PakInfo_Click"/>
                                    <Button Content="列出文件" Style="{StaticResource SecondaryButtonStyle}" Click="PakList_Click"/>
                                    <Button Content="生成哈希清单" Style="{StaticResource SecondaryButtonStyle}" Click="PakHash_Click"/>
                                    <Button Content="解包" Style="{StaticResource SecondaryButtonStyle}" Click="PakUnpack_Click"/>
                                </StackPanel>
                                <ListBox x:Name="PakEntriesList" Height="180" Margin="0,14,0,0" BorderBrush="{StaticResource BorderBrush}" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="打包 Mod 内容" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="pack-root 源目录" Style="{StaticResource FieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PackSourceBox" Margin="0,0,8,0"/><Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButtonStyle}" Tag="PackSourceBox" Click="BrowseFolder_Click"/></Grid></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="输出 .pak" Style="{StaticResource FieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PackOutputBox" Margin="0,0,8,0"/><Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButtonStyle}" Tag="PackOutputBox|UE PAK|*.pak" Click="BrowseSaveFile_Click"/></Grid></StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="挂载点" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="PackMountPointBox" Text="../../../"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="PAK 版本" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="PakVersionCombo" SelectedIndex="0"><ComboBoxItem Content="V11 (UE4.26–5.3)" Tag="V11"/><ComboBoxItem Content="V8B (UE4.23–4.24)" Tag="V8B"/><ComboBoxItem Content="V5 (UE4.20)" Tag="V5"/></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="AES Key（读取加密 PAK，可选）" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="PakAesKeyBox"/></StackPanel>
                                </Grid>
                                <Button Content="打包为 PAK" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="PakPack_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <StackPanel><TextBlock Text="打包检查" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="建议先确认 pack-root 最外层是项目名目录，再使用 ../../../ 挂载点。生成后可点击“查看信息”验证索引。" Style="{StaticResource CaptionStyle}"/></StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="AssetPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="资源结构与蓝图属性" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="通过 UAssetAPI 将 cooked .uasset 导出为可检查 JSON，修改后写回。复杂蓝图图节点重写并不适合 cook 后直接修改。" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="资源浏览器搜索" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="AssetSearchBox" TextChanged="AssetSearchBox_TextChanged"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="类型" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="AssetTypeFilterCombo" SelectionChanged="AssetTypeFilterCombo_SelectionChanged" SelectedIndex="0"><ComboBoxItem Content="全部"/><ComboBoxItem Content="蓝图"/><ComboBoxItem Content="骨骼网格"/><ComboBoxItem Content="静态网格"/><ComboBoxItem Content="动画"/><ComboBoxItem Content="贴图"/><ComboBoxItem Content="材质"/><ComboBoxItem Content="特效"/></ComboBox></StackPanel>
                                    <Button Grid.Column="2" Content="扫描解包目录" Style="{StaticResource PrimaryButtonStyle}" Margin="12,17,8,0" Click="AssetScanFolder_Click"/>
                                    <Button Grid.Column="3" Content="打开选中资源" Style="{StaticResource SecondaryButtonStyle}" Margin="0,17,0,0" Click="AssetBrowserOpen_Click"/>
                                </Grid>
                                <ListBox x:Name="AssetBrowserList" Height="170" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" MouseDoubleClick="AssetBrowserList_MouseDoubleClick" FontFamily="Consolas" FontSize="11"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text=".uasset 文件" Style="{StaticResource FieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AssetPathBox" TextChanged="AssetPathBox_TextChanged" Margin="0,0,8,0"/><Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButtonStyle}" Tag="AssetPathBox|UE Asset|*.uasset" Click="BrowseFile_Click"/></Grid></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="引擎版本" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="AssetEngineCombo" SelectedIndex="0"><ComboBoxItem Content="UE 4.26"/><ComboBoxItem Content="UE 4.27"/><ComboBoxItem Content="UE 5.0"/><ComboBoxItem Content="UE 5.1"/></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Bottom"><Button Content="检查资源" Style="{StaticResource PrimaryButtonStyle}" Click="AssetInspect_Click"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Mappings 文件（可选）" Style="{StaticResource FieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MappingsPathBox" Margin="0,0,8,0"/><Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButtonStyle}" Tag="MappingsPathBox|Mappings|*.usmap;*.jmap" Click="BrowseFile_Click"/></Grid></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="JSON 工作文件" Style="{StaticResource FieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AssetJsonPathBox" Margin="0,0,8,0"/><Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButtonStyle}" Tag="AssetJsonPathBox|JSON|*.json" Click="BrowseSaveFile_Click"/></Grid></StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="导出 JSON" Style="{StaticResource PrimaryButtonStyle}" Click="AssetExport_Click"/>
                                    <Button Content="写回 uasset" Style="{StaticResource SecondaryButtonStyle}" Click="AssetImport_Click"/>
                                    <Button Content="JSON → uasset → JSON 校验" Style="{StaticResource SecondaryButtonStyle}" Click="AssetRoundTrip_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="AssetSummaryText" Text="尚未检查资源。" Style="{StaticResource CaptionStyle}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="JSON 编辑器" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="查找" Style="{StaticResource SecondaryButtonStyle}" Click="JsonFind_Click"/><Button Content="格式化" Style="{StaticResource SecondaryButtonStyle}" Click="JsonFormat_Click"/></StackPanel>
                                </Grid>
                                <TextBox x:Name="AssetJsonEditor" Height="520" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="FModelPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="最新 FModel / CUE4Parse 解包" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="FModel 2b09c12f 负责图形浏览与预览；CUE4Parse CLI 负责可断点续传的批量解包、对象 JSON 和 Roco 配置读取。两者随程序构建版本配套。" Style="{StaticResource CaptionStyle}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
